{
  "name": "@akapetaniou/azure-query-mcp",
  "version": "0.4.0",
  "description": "Read-only MCP server for Azure Log Analytics, Microsoft Sentinel and Azure Resource Graph queries.",
  "license": "MIT",
  "author": "Andreas Kapetaniou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kapetanios55/azure-query-mcp.git"
  },
  "homepage": "https://github.com/kapetanios55/azure-query-mcp#readme",
  "bugs": "https://github.com/kapetanios55/azure-query-mcp/issues",
  "keywords": [
    "azure",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "log-analytics",
    "microsoft-sentinel",
    "resource-graph",
    "kql",
    "security",
    "threat-hunting"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "azure-query-mcp": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/arm-operationalinsights": "^11.0.0",
    "@azure/core-auth": "^1.11.0",
    "@azure/identity": "^4.13.2",
    "@azure/monitor-query-logs": "^1.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@kusto/language-service-next": "12.4.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
