{
  "name": "@kapetanios55/azure-query-mcp",
  "version": "0.2.0",
  "description": "A read-only MCP server for Azure Log Analytics and Azure Resource Graph.",
  "license": "MIT",
  "author": "Andreas Kapetaniou",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kapetanios55/azure-query-mcp.git"
  },
  "homepage": "https://github.com/Kapetanios55/azure-query-mcp#readme",
  "bugs": "https://github.com/Kapetanios55/azure-query-mcp/issues",
  "keywords": [
    "azure",
    "mcp",
    "log-analytics",
    "resource-graph",
    "kql"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "azure-query-mcp": "dist/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@azure/arm-operationalinsights": "^11.0.0",
    "@azure/core-auth": "^1.11.0",
    "@azure/identity": "^4.0.0",
    "@azure/monitor-query-logs": "^1.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.0"
  }
}
