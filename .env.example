# Optional for local interactive credentials. Required for service principals.
AZURE_TENANT_ID=

# Set these only when using an Entra service principal.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Recommended in production to exclude developer credentials from the chain.
AZURE_TOKEN_CREDENTIALS=prod

# Optional: AzurePublicCloud (default), AzureUSGovernment or AzureChinaCloud.
AZURE_QUERY_MCP_CLOUD=

# Optional: true lets queries read other workspaces, apps, resources, ADX clusters or ARG.
AZURE_QUERY_MCP_ALLOW_CROSS_RESOURCE=false
